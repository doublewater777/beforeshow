    {
      "name": "推荐 · 露出 → 点击转化（30 天）",
      "description": "按 feature / surface 拆分。露出只来自主卡（card）；通知点击（notification）无露出事件，转化率为空。",
      "query": {
        "kind": "DataTableNode",
        "source": {
          "kind": "HogQLQuery",
          "query": "SELECT properties.feature AS feature, properties.surface AS surface, countIf(event = 'feature_recommendation_shown') AS shown, countIf(event = 'feature_recommendation_tapped') AS tapped, round(100.0 * tapped / nullIf(shown, 0), 1) AS tap_percent FROM events WHERE event IN ('feature_recommendation_shown', 'feature_recommendation_tapped') AND properties.$app_namespace = 'com.doublewaterapps.beforeshow' AND properties.$is_emulator = false AND properties.$is_sideloaded = false AND timestamp > now() - INTERVAL 30 DAY GROUP BY feature, surface ORDER BY feature, surface"
        }
      },
      "tags": [
        "product-analytics"
      ],
      "id": 12939096,
      "short_id": "AqPeFUZS"
    }
