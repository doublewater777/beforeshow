{
  "name": "beforeshow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @beforeshow/web",
    "dev:web": "npm run dev --workspace @beforeshow/web",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @beforeshow/web",
    "start:web": "npm run start --workspace @beforeshow/web",
    "start:prod:web": "npm run start:prod --workspace @beforeshow/web"
  }
}
