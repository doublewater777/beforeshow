<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>3. 文本导出 · 格式排版与复制</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
body {
  margin: 0;
  padding: 0;
  background: #000000;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}
* {
  box-sizing: border-box;
}
.device-shell {
  width: 390px;
  height: 844px;
  background: #040508;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: #F3F4F8;
}
/* Blurred background backdrop simulating page behind sheet */
.backdrop-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 20%, #1A1F2C 0%, #07090E 100%);
  filter: blur(10px) brightness(0.4);
  transform: scale(1.05);
  pointer-events: none;
}
/* Device Chrome */
.status-bar {
  height: 44px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.2px;
  z-index: 30;
  flex-shrink: 0;
}
.dynamic-island {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 32px;
  background: #000000;
  border-radius: 20px;
  z-index: 40;
}
.home-bar {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  width: 134px;
  height: 5px;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 3px;
  z-index: 40;
}
/* Sheet Modal Container */
.sheet-container {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  top: 90px;
  background: #0F131D;
  border-top-left-radius: 28px;
  border-top-right-radius: 28px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.8);
  display: flex;
  flex-direction: column;
  z-index: 20;
}
.sheet-handle-bar {
  width: 36px;
  height: 4px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.25);
  margin: 10px auto 4px auto;
  flex-shrink: 0;
}
.sheet-header {
  padding: 12px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}
.sheet-title {
  font-size: 17px;
  font-weight: 700;
  color: #FFFFFF;
}
.close-btn {
  width: 30px;
  height: 30px;
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.08);
  border: none;
  color: #94A3B8;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}
/* Sheet Scrollable Body */
.sheet-body {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 16px 20px 100px 20px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  scrollbar-width: none;
}
.sheet-body::-webkit-scrollbar {
  display: none;
}
/* Format Segment Tabs */
.format-segmented {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 3px;
  display: flex;
}
.segment-btn {
  flex: 1;
  padding: 8px 0;
  text-align: center;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 600;
  color: #94A3B8;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
}
.segment-btn.active {
  background: #F59E0B;
  color: #000000;
  box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25);
}
/* Formatted Preview Box */
.preview-card {
  background: #080A10;
  border: 1px solid rgba(255, 255, 255, 0.09);
  border-radius: 14px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
}
.preview-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 11px;
  color: #64748B;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.08);
  padding-bottom: 8px;
}
.preview-badge {
  color: #34D399;
  display: flex;
  align-items: center;
  gap: 4px;
  font-weight: 600;
}
.text-content-area {
  font-family: ui-monospace, SFMono-Regular, "SF Pro Text", Menlo, Consolas, monospace;
  font-size: 11.5px;
  line-height: 1.6;
  color: #E2E8F0;
  white-space: pre-wrap;
  word-break: break-all;
  user-select: text;
  max-height: 220px;
  overflow-y: auto;
  scrollbar-width: none;
}
/* Inclusion Options */
.options-section {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.options-title {
  font-size: 12px;
  font-weight: 700;
  color: #94A3B8;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.checkbox-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 10px 14px;
  font-size: 12px;
  color: #E2E8F0;
}
.custom-check {
  width: 18px;
  height: 18px;
  border-radius: 5px;
  background: #F59E0B;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #000000;
}
/* Bottom Floating Action Dock */
.sheet-dock {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12px 20px 28px 20px;
  background: linear-gradient(180deg, rgba(15, 19, 29, 0) 0%, #0F131D 20%, #0F131D 100%);
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 30;
}
.btn-primary-copy {
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  border: none;
  color: #000000;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(245, 158, 11, 0.3);
}
.secondary-actions {
  display: flex;
  gap: 10px;
}
.btn-secondary {
  flex: 1;
  height: 40px;
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #CBD5E1;
  font-size: 12px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
}
</style>
</helmet>

<div class="device-shell">
  <div class="backdrop-bg"></div>
