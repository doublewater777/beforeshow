  border: 1px solid rgba(255, 255, 255, 0.08);
  color: #94A3B8;
  cursor: pointer;
}
.style-pill.active {
  background: #F59E0B;
  color: #000000;
  border-color: #F59E0B;
}
/* Poster Viewport Scroll */
.poster-viewport {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 4px 20px 96px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  scrollbar-width: none;
}
.poster-viewport::-webkit-scrollbar {
  display: none;
}
/* The Actual Generated Card to Export */
.export-card {
  width: 100%;
  background: #11141E;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 20px;
  padding: 20px 18px;
