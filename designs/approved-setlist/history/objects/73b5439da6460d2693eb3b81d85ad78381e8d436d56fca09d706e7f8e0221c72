  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  cursor: pointer;
  padding: 0;
}
.nav-title {
  font-size: 16px;
  font-weight: 700;
}
/* Style Switcher Bar */
.style-switch-bar {
  padding: 0 16px 8px 16px;
  display: flex;
  gap: 8px;
  justify-content: center;
}
.style-pill {
  padding: 5px 12px;
