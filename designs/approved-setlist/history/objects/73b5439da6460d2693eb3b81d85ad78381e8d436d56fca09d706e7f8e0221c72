  -webkit-font-smoothing: antialiased;
}
* {
  box-sizing: border-box;
}
.device-shell {
  width: 390px;
  height: 844px;
  background: #07090E;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  color: #F3F4F8;
}
/* Device Chrome */
.status-bar {
  height: 44px;
  padding: 0 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: -0.2px;
  z-index: 30;
  flex-shrink: 0;
}
.dynamic-island {
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 32px;
  background: #000000;
  border-radius: 20px;
  z-index: 40;
}
.home-bar {
  position: absolute;
  bottom: 8px;
  left: 50%;
